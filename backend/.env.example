# Database
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/restaurant_erp?schema=public"

# Auth
JWT_SECRET="change_me_to_a_long_random_string"

# Server
PORT=4000

# --- Email (optional) ---
# Without SMTP_HOST set, OTP codes and other emails are logged to the
# console instead of sent — fine for local development, not for production.
# Works with any SMTP provider (SendGrid, Resend, Amazon SES, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@yourdomain.com

# --- Site Owner seed (used only once, by `npm run seed:site-owner`) ---
# Change these before running against a real production database.
SITE_OWNER_LOGIN_ID=tomsiteowner
SITE_OWNER_PASSWORD=tom_owner
SITE_OWNER_NAME=Site Owner
